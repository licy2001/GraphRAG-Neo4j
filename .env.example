# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=fan-kg-password
NEO4J_DATABASE=neo4j

# Microsoft GraphRAG reads GRAPHRAG_API_KEY from data/graphrag/.env after `graphrag init`.
# Keep a project-level copy here for scripts that call OpenAI-compatible services directly.
GRAPHRAG_API_KEY=replace-with-your-key

# Optional defaults used by scripts/init_graphrag.ps1
GRAPHRAG_MODEL=gpt-4.1-mini
GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-small

# Project paths
FAN_KG_ROOT=.
FAN_KG_STRUCTURED_DIR=data/raw/structured
FAN_KG_GRAPHRAG_ROOT=data/graphrag
